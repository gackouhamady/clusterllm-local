   "source": [
    "stats = []\n",
    "for ds in datasets:\n",
    "    for split in [\"large\", \"small\"]:\n",
    "        path = os.path.join(base_path, ds, f\"{split}.jsonl\")\n",
    "        if os.path.exists(path):\n",
    "            df = pd.read_json(path, lines=True)\n",
    "            counts = df['label'].value_counts()\n",
    "            stats.append({\n",
    "                'dataset': ds,\n",
    "                'split': split,\n",
    "                'ratio': counts.min() / counts.max(),\n",
    "                'nb_classes': len(counts),\n",
    "                'total_rows': len(df)\n",
    "            })\n",
    "\n",
    "# Création d'un tableau de bord\n",
    "df_stats = pd.DataFrame(stats).sort_values(by='ratio')\n",
    "print(\"---  DES DATASETS LES PLUS DÉSÉQUILIBRÉS ---\")\n",
    "print(df_stats.head(30))"
   ]
  }
