    "import os\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Configuration du style\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams['figure.figsize'] = (20, 6)\n",
    "\n",
    "# Liste mise à jour avec les noms EXACTS des dossiers de la capture d'écran\n",
    "datasets = [\n",
    "    \"arxiv_fine\",\n",
    "    \"banking77\",\n",
    "    \"clinc\",\n",
    "    \"clinc_domain\",\n",
    "    \"few_event\",\n",
    "    \"few_nerd_nat\",\n",
    "    \"few_rel_nat\",\n",
    "    \"go_emotion\",\n",
    "    \"massive_intent\",\n",
    "    \"massive_scenario\",\n",
    "    \"mtop_domain\",\n",
    "    \"mtop_intent\",\n",
    "    \"reddit\",\n",
    "    \"stackexchange\"\n",
    "]\n",
    "\n",
    "# Chemin vers les données (Vérifie que ce chemin pointe bien vers le dossier racine \"datasets\" de ta capture)\n",
    "base_path = \"../datasets\"\n",
    "\n",
    "for ds in datasets:\n",
    "    fig, axes = plt.subplots(1, 2)\n",
    "    fig.suptitle(f\"Dataset: {ds.upper()}\", fontsize=16, fontweight='bold', y=1.05)\n",
    "    \n",
    "    for i, split in enumerate([\"large\", \"small\"]):\n",
    "        file_path = os.path.join(base_path, ds, f\"{split}.jsonl\")\n",
    "        \n",
    "        if os.path.exists(file_path):\n",
    "            df = pd.read_json(file_path, lines=True)\n",
    "            \n",
    "            # Vérifie que la colonne s'appelle bien 'label' (parfois c'est 'intent' ou 'category')\n",
    "            if 'label' in df.columns:\n",
    "                counts = df['label'].value_counts()\n",
    "                \n",
    "                # On affiche les 25 classes les plus fréquentes\n",
    "                top_n = counts.head(25)\n",
    "                sns.barplot(x=top_n.index.astype(str), y=top_n.values, ax=axes[i], palette=\"magma\")\n",
    "                \n",
    "                # Calcul du ratio de déséquilibre (Min / Max)\n",
    "                imb_ratio = (counts.min() / counts.max())\n",
    "                \n",
    "                axes[i].set_title(f\"Split {split.upper()} (Total: {len(df)} | Ratio: {imb_ratio:.2f})\")\n",
    "                axes[i].tick_params(axis='x', rotation=45)\n",
    "                axes[i].set_ylabel(\"Nombre d'exemples\")\n",
    "            else:\n",
    "                axes[i].text(0.5, 0.5, f\"Erreur : pas de colonne 'label'\", ha='center', va='center', color='red')\n",
    "                axes[i].axis('off')\n",
    "        else:\n",
    "            axes[i].text(0.5, 0.5, f\"{split}.jsonl non trouvé\\n{file_path}\", ha='center', va='center')\n",
    "            axes[i].axis('off')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    print(\"-\" * 100)"
   ]
  },
  {
