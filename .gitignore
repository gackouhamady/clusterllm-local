# Python
__pycache__/
*.pyc
.env
.venv/
venv/

# Data (On ignore les gros fichiers, mais on force l'acceptation des .dvc)
/data/*
!*.dvc
!/data/.gitignore

# IDE
.vscode/
.idea/

# DVC Config
!/.dvc/


# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.pdf
!reports/**/*.pdf  # Exception: On veut quand même garder les PDF finaux dans reports