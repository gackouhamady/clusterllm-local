# ==========================================
# 1. Python, OS & Environnement
# ==========================================
__pycache__/
*.py[cod]
*.pyd
.venv/
.env
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
.DS_Store
docs/build/
sitecustomize.py.bak

# ==========================================
# 2. Sécurité & Clés (NE JAMAIS PUSHER)
# ==========================================
creds.json
*credentials*.json
cellular-effect-*.json
.gdrive/

# ==========================================
# 3. Fichiers Lourds & Modèles (Gérés par DVC)
# ==========================================
# Bloque absolument ces extensions partout dans le projet
*.hdf5
*.h5
*.safetensors
*.bin
*.pkl
*.pt
*.pth

# ==========================================
# 4. Données brutes et générées
# ==========================================
data/raw/*.csv
src/clusterllm/datasets/**/*.jsonl

# ==========================================
# 5. Dossiers temporaires et caches
# ==========================================
.cache/
.dvc/tmp/
_backup_dvc/
B[Embeddings]/
C[Clustering]/
D[Cluster]/

# ==========================================
# 6. Résultats intermédiaires (Évite de polluer Git)
# ==========================================
# On ignore les dossiers contenant des milliers de JSONs intermédiaires
runs/perspective/triplets/
runs/perspective/triplet_preds/
runs/perspective/converted_triplets/
runs/perspective/checkpoints/
runs/granularity/sampled_pairs/
runs/granularity/prompts/
runs/granularity/_work_predict_pairs/
runs/granularity/predicted_pair_results/

src/clusterllm/perspective/triplet_prediction/sampled_triplet_results/
src/clusterllm/perspective/predict_triplet/predicted_triplet_results/
src/clusterllm/perspective/finetuning/converted_triplet_results/
src/clusterllm/perspective/finetuning/checkpoints/
src/clusterllm/granularity/predicted_pair_results/
src/clusterllm/granularity/sampled_pair_results/

# Note : Les dossiers utiles comme `runs/summary/` ou 
# `runs/granularity/num_clusters/` NE SONT PAS ignorés ici, 
# donc leurs .json et .txt seront bien poussés sur GitHub !

# ==========================================
# 7. Forcer Git à suivre les fichiers DVC
# ==========================================
!*.dvc
!dvc.yaml
!dvc.lock
!.dvcignore

# ==========================================
# 8. Autres exclusions spécifiques
# ==========================================
prompts.json